---
// 全ページ共通の Ko-fi 支援バナー（neuvecom/kofi-banner の Web コンポーネントを読み込む）
// バナーの文言や見た目を変えたら kofi-banner 側で新しいタグを打ち、ここの @vX.Y.Z を上げる
const user = 'otasuke';
---

<div class="kofi-banner-wrap">
    <kofi-banner user={user}>
        <a href={`https://ko-fi.com/${user}`}>Ko-fi で制作者を支援する</a>
    </kofi-banner>
</div>

<script is:inline src="https://cdn.jsdelivr.net/gh/neuvecom/kofi-banner@v1.0.0/kofi-banner.js" defer></script>

<style>
    .kofi-banner-wrap {
        margin-top: 2rem;
    }
</style>
